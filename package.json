{
  "name": "electron-skd",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 + Vite + Electron + Node backend scaffold with IPC routing.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/screenshot.cjs && node --check server/backend.cjs && node --check server/sessionAssets.cjs",
    "test": "node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "electron",
    "desktop",
    "vue3",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "echarts": "^6.1.0",
    "electron-screenshots": "^0.6.1",
    "element-plus": "^2.14.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "sass": "^1.100.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
